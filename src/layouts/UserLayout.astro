---
// src/layouts/UserLayout.astro
import { PublicNavbar } from "@/modules/user/shared/components/PublicNavbar";
import ChatbotWidget from "@/modules/user/chatbot/components/ChatbotWidget";
import { Toaster } from "sonner";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DeParraSpitz - Catering & Eventos",
  description = "Experiencias gastronómicas premium. Catering, eventos y parrillas.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- 🔥 View Transitions API nativa del navegador -->
    <meta name="view-transition" content="same-origin" />

    <script is:inline>
      (function() {
        const t = localStorage.getItem("deparraspitz-theme");
        const d = window.matchMedia("(prefers-color-scheme: dark)").matches;
        try {
          const parsed = JSON.parse(t);
          const theme = parsed?.state?.theme;
          if (theme === "dark" || (!theme && d)) {
            document.documentElement.classList.add("dark");
            document.documentElement.style.colorScheme = "dark";
          }
        } catch {
          if (d) {
            document.documentElement.classList.add("dark");
            document.documentElement.style.colorScheme = "dark";
          }
        }
      })();
    </script>

    <!-- 🔥 Transiciones suaves entre páginas -->
    <style is:global>
      @keyframes page-fade-in {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes page-fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      ::view-transition-old(root) {
        animation: page-fade-out 0.15s ease-out forwards;
      }

      ::view-transition-new(root) {
        animation: page-fade-in 0.3s ease-out forwards;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col transition-colors duration-300">
    
    <PublicNavbar client:load />
    
    <div class="flex-1">
      <slot />
    </div>

    <ChatbotWidget client:load />
    <Toaster richColors position="top-right" client:load />
  </body>
</html>