---
import "@/styles/globals.css";
import AdminLayoutReact from "./AdminLayoutReact";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    
    {/* Pasamos el control a React. Al usar client:only, solucionamos el problema
        del contexto de SidebarProvider y el warning de tamaño de Recharts */}
    <AdminLayoutReact client:only="react">
      <slot />
    </AdminLayoutReact>

  </body>
</html>