---
import "@/styles/globals.css";
import { SidebarProvider, SidebarTrigger } from "@/components/ui/sidebar";
import { AppSidebar } from "@/components/shared/AppSidebar";
import { QueryProvider } from "@/components/shared/QueryProvider"; // <-- Aquí también
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100">
    <QueryProvider client:only="react">
      <SidebarProvider client:only="react">
        <AppSidebar role="admin" client:only="react" />
        
        <main class="w-full min-h-screen flex flex-col">
          <header class="p-4 flex items-center border-b border-zinc-800 bg-zinc-950/50 backdrop-blur">
            <SidebarTrigger client:only="react" />
            <h1 class="ml-4 font-semibold text-zinc-100">Dashboard Administrativo</h1>
          </header>
          
          <div class="p-6 flex-1">
            <slot />
          </div>
        </main>
      </SidebarProvider>
    </QueryProvider>
  </body>
</html>