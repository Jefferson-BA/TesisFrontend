---
// src/pages/superadmin/audit.astro
import AdminLayout from "@/layouts/AdminLayout.astro";
import { SuperadminAuditPage } from "@/modules/superadmin/components/SuperadminAuditPage";
---

<AdminLayout title="Bitácora de Auditoría Maestra">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white">
        Bitácora de Auditoría (Audit Trail)
      </h2>
      <p class="text-zinc-400 text-sm mt-1">
        Historial inmutable de eventos críticos, traza de direcciones IP, cambios de estado y visor de diferencias JSON.
      </p>
    </div>

    <SuperadminAuditPage client:only="react" />
  </div>
</AdminLayout>
