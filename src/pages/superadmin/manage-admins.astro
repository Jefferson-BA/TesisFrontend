---
// src/pages/superadmin/manage-admins.astro
import AdminLayout from "@/layouts/AdminLayout.astro";
import { SuperadminUsersPage } from "@/modules/superadmin/components/SuperadminUsersPage";
---

<AdminLayout title="Gestión de Usuarios y Administradores">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white">
        Gestión de Usuarios y Roles
      </h2>
      <p class="text-zinc-400 text-sm mt-1">
        Supervisa cuentas de comensales y administradores, modifica privilegios de acceso y gestiona estados de suspensión.
      </p>
    </div>

    <SuperadminUsersPage client:only="react" />
  </div>
</AdminLayout>
