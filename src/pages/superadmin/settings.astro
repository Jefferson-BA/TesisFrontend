---
// src/pages/superadmin/settings.astro
import AdminLayout from "@/layouts/AdminLayout.astro";
import { SuperadminSettingsPage } from "@/modules/superadmin/components/SuperadminSettingsPage";
---

<AdminLayout title="Configuración Crítica y Modo Mantenimiento">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white">
        Configuración Crítica del Sistema
      </h2>
      <p class="text-zinc-400 text-sm mt-1">
        Control maestro del modo mantenimiento global y administración de credenciales de pasarelas y servicios externos.
      </p>
    </div>

    <SuperadminSettingsPage client:only="react" />
  </div>
</AdminLayout>
