---
// src/pages/user/profile.astro
export const prerender = false;

import UserLayout from "@/layouts/UserLayout.astro";
import UserOrders from "@/modules/user/components/UserOrders";
import UserProfileCard from "../../modules/admin/usuarios/components/UserProfileCard";
---

<UserLayout 
  title="Mi Perfil | DeParraSpitz"
  description="Gestiona tu perfil y revisa tu historial de reservas."
>
  <main class="max-w-7xl mx-auto px-6 pb-20">
    <div class="mb-10">
      <h1 class="text-5xl font-serif font-bold text-foreground">Mi Perfil</h1>
      <p class="text-muted-foreground mt-3">Gestiona tu información personal y revisa el historial de tus reservas.</p>
    </div>

    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Tarjeta de perfil (1/3) -->
      <div class="lg:col-span-1">
        <UserProfileCard client:visible />
      </div>

      <!-- Reservas (2/3) -->
      <div class="lg:col-span-2">
        <UserOrders client:visible />
      </div>
    </section>
  </main>
</UserLayout>