---
import "@/styles/globals.css";

import { PublicNavbar } from "@/modules/user/components/PublicNavbar";

import UserProfileCard from "@/modules/admin/components/UserProfileCard";
import UserOrders from "@/modules/admin/components/UserOrders";
import EditProfileForm from "@/modules/admin/components/EditProfileForm";

import { Toaster } from "sonner";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Mi Perfil | DeParraSpitz</title>
  </head>

  <body class="min-h-screen bg-[#0b0806] text-white">
    
    <PublicNavbar client:only="react" />

    <main class="pt-[120px] max-w-7xl mx-auto px-6 pb-20">
      
      <div class="mb-10">
        <h1 class="text-5xl font-serif font-bold">
          Mi Perfil
        </h1>

        <p class="text-[#f1d8b5] mt-3">
          Revisa tus datos personales y tu historial de pedidos.
        </p>
      </div>

      <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <UserProfileCard client:only="react" />

        <EditProfileForm client:only="react" />

        <div class="lg:col-span-2">
          <UserOrders client:only="react" />
        </div>

      </section>

    </main>

    <Toaster
      richColors
      position="top-right"
      client:only="react"
    />

  </body>
</html>