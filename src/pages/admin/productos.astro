---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/globals.css";
import ProductDashboard from "@/modules/admin/productos/components/ProductDashboard";
---

<AdminLayout title="Dashboard | Productos">
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-8">
    
    <div>
      {/* CORRECCIÓN: text-white -> text-foreground */}
      <h1 class="text-5xl font-bold text-foreground">
        Gestión de Productos
      </h1>
      {/* CORRECCIÓN: text-zinc-400 -> text-muted-foreground */}
      <p class="text-muted-foreground mt-2">
        Administra el catálogo del restaurante
      </p>
    </div>

    <ProductDashboard client:load />

  </main>
</AdminLayout>