---
import AdminLayout from "@/layouts/AdminLayout.astro";

import ProductForm from "@/modules/auth/components/ProductForm";
import ProductTable from "@/modules/auth/components/ProductTable";
---
<AdminLayout>
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-8">
    
    <div>
      <h1 class="text-5xl font-bold text-white">
        Gestión de Productos
      </h1>

      <p class="text-zinc-400 mt-2">
        Administra el catálogo del restaurante
      </p>
    </div>

    <ProductForm client:load />

    <ProductTable client:load />

  </main>
</AdminLayout>