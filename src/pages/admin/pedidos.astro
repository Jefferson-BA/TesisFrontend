---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/globals.css";
import AdminOrdersTable from '@/modules/admin/pedidos/components/AdminOrdersTable';
---
<AdminLayout>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">Gestión de Pedidos</h1>
      <p class="text-muted-foreground text-sm">Monitorea y despacha las órdenes de comida en tiempo real.</p>
    </div>
    
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm transition-colors">
      <AdminOrdersTable client:load />
    </div>
  </div>
</AdminLayout>