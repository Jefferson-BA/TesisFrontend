---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "../../styles/globals.css";
import AdminUsersTable from "@/modules/auth/components/AdminUsersTable";---

<AdminLayout>
  <section class="admin-panel">

    <div class="admin-header">
      <h1>Panel de Administración</h1>
      <p>Bienvenido, admin@deparraspitz.com</p>
    </div>

    <div class="admin-tabs">
      <a class="tab-resumen" href="#resumen">▦ Resumen</a>
      <a class="tab-pedidos" href="#pedidos">▣ Pedidos</a>

      <a class="tab-productos" href="/admin/productos">
        ▧ Productos
      </a>

      <a class="tab-promociones" href="#promociones">◇ Promociones</a>
      <a class="tab-perfil" href="#perfil">♙ Perfil</a>
    </div>

    <!-- RESUMEN -->
    <section id="resumen" class="tab-section default-section">
      <div class="stats-grid">
        <div class="stat-card">
          <div>
            <p>Ventas Totales Históricas</p>
            <h2>S/ 4280.00</h2>
          </div>
          <span>S/</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Ingresos del Mes</p>
            <h2>S/ 0.00</h2>
          </div>
          <span>↗</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Pedidos de Hoy</p>
            <h2>0</h2>
          </div>
          <span>▣</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Total Pedidos</p>
            <h2>1</h2>
          </div>
          <span>▤</span>
        </div>
      </div>
    </section>

    <!-- PEDIDOS -->
    <section id="pedidos" class="tab-section admin-card">
      <h2>Gestión de Pedidos</h2>

      <table>
        <thead>
          <tr>
            <th>N° Pedido</th>
            <th>Cliente</th>
            <th>Fecha Evento</th>
            <th>Total</th>
            <th>Método Pago</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>3xx38o287gkpy6q</td>
            <td>
              <strong>ELIAS</strong>
              <small>3600267</small>
            </td>
            <td>24/4/2026</td>
            <td>S/ 4280.00</td>
            <td>Tarjeta</td>
            <td>
              <button class="status">Pendiente</button>
            </td>
            <td>👁</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- PROMOCIONES -->
    <section id="promociones" class="tab-section admin-card">
      <div class="card-head">
        <h2>Promociones Activas</h2>
        <button class="yellow-btn">Nueva Promoción</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Título</th>
            <th>Descuento</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
          </tr>
        </thead>
      </table>
    </section>

    <!-- PERFIL -->
    <section id="perfil" class="tab-section">
      <div class="profile-card">
        <h2>Perfil de Administrador</h2>

        <p>Email de acceso</p>

        <strong>
          admin@deparraspitz.com
        </strong>

        <button>
          Cerrar Sesión
        </button>
      </div>

      <AdminUsersTable client:load />
    </section>

  </section>
</AdminLayout>