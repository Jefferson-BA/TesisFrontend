---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/globals.css";
import AdminStatsCharts from "@/modules/admin/components/AdminStatsCharts";
---

<AdminLayout>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-100">
        Panel de Administración
      </h1>
      <p class="text-zinc-400 text-sm">
        Aquí tienes el resumen general de tu restaurante.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div
        class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 shadow-sm flex justify-between items-center"
      >
        <div>
          <p class="text-sm font-medium text-zinc-400">
            Ventas Totales Históricas
          </p>
          <h2 class="text-2xl font-bold text-zinc-100 mt-1">S/ 4280.00</h2>
        </div>
        <span class="text-xl font-bold text-emerald-500">S/</span>
      </div>

      <div
        class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 shadow-sm flex justify-between items-center"
      >
        <div>
          <p class="text-sm font-medium text-zinc-400">Promociones Activas</p>
          <h2 class="text-2xl font-bold text-zinc-100 mt-1">1</h2>
        </div>
        <span class="text-xl text-amber-500">◇</span>
      </div>

      <div
        class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 shadow-sm flex justify-between items-center"
      >
        <div>
          <p class="text-sm font-medium text-zinc-400">Usuarios Registrados</p>
          <h2 class="text-2xl font-bold text-zinc-100 mt-1">6</h2>
        </div>
        <span class="text-xl text-blue-500">♙</span>
      </div>

      <div
        class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 shadow-sm flex justify-between items-center"
      >
        <div>
          <p class="text-sm font-medium text-zinc-400">Total Pedidos</p>
          <h2 class="text-2xl font-bold text-zinc-100 mt-1">0</h2>
        </div>
        <span class="text-xl text-purple-500">▤</span>
      </div>
    </div>

      <AdminStatsCharts client:load />
  </div>
</AdminLayout>
