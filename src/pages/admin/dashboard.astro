---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "../../styles/globals.css";

import AdminStatsCharts from "@/modules/auth/components/AdminStatsCharts";
import AdminOrdersTable from "@/modules/auth/components/AdminOrdersTable";
import PromoForm from "@/modules/auth/components/PromoForm";
import CategoryForm from "@/modules/auth/components/CategoryForm";
---

<AdminLayout>
  <section class="admin-panel">

    <div class="admin-header">
      <h1>Panel de Administración</h1>
    </div>

    <div class="admin-tabs">
      <a class="tab-resumen" href="#resumen">▦ Resumen</a>

      <a class="tab-pedidos" href="#pedidos">
        ▣ Pedidos
      </a>

      <a class="tab-productos" href="/admin/productos">
        ▧ Productos
      </a>

      <a class="tab-promociones" href="#promociones">
        ◇ Promociones
      </a>

   
      </a>
    </div>

    <!-- RESUMEN -->
    <section id="resumen" class="tab-section default-section">
      <div class="stats-grid">

        <div class="stat-card">
          <div>
            <p>Ventas Totales Históricas</p>
            <h2>S/ 4280.00</h2>
          </div>
          <span>S/</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Promociones Activas</p>
            <h2 id="promo-count">1</h2>
          </div>
          <span>◇</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Usuarios Registrados</p>
            <h2 id="user-count">4</h2>
          </div>
          <span>♙</span>
        </div>

        <div class="stat-card">
          <div>
            <p>Total Pedidos</p>
            <h2 id="order-count">1</h2>
          </div>
          <span>▤</span>
        </div>

      </div>

      <AdminStatsCharts client:load />
    </section>

    <!-- PEDIDOS -->
    <section id="pedidos" class="tab-section">
      <AdminOrdersTable client:load />
    </section>

    <!-- PROMOCIONES -->
    <section id="promociones" class="tab-section admin-card">
      <PromoForm client:load />
    </section>

  
  </section>
</AdminLayout>