---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/globals.css";
import PromoForm from "@/modules/admin/promociones/components/PromoForm";
import PromoBanner from '@/modules/admin/promociones/components/PromoBanner';
---
<AdminLayout title="Dashboard | Promociones">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">Promociones</h1>
      <p class="text-muted-foreground text-sm">Administra los descuentos del restaurante y publica ofertas activas.</p>
    </div>
    
    <div class="max-w-4xl mx-auto rounded-xl border border-border bg-card text-card-foreground p-6 shadow-sm">
      <PromoForm client:load />
    </div>
  </div>
</AdminLayout>