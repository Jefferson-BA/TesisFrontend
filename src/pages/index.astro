---
import '@/styles/globals.css';

import { PublicNavbar } from '@/modules/user/components/PublicNavbar';
import { Hero } from '@/modules/user/components/Hero';
import { Servicios } from '@/modules/user/components/Servicios';
import { Testimonios } from '@/modules/user/components/Testimonios';
import { Contacto } from '@/modules/user/components/Contacto';
import PromoBanner from "@/modules/admin/components/PromoBanner";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>DeParraSpitz | Catering & Eventos</title>
  </head>

  <body class="min-h-screen bg-[#0b0806] text-white font-sans">
    
    <PublicNavbar client:only="react" />

    <main>
      <Hero client:only="react" />
      <Servicios client:only="react" />
      <PromoBanner client:load />
      <Testimonios client:only="react" />
      <Contacto client:only="react" />
    </main>

  </body>
</html>