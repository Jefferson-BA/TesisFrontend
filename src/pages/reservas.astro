---
import UserLayout from "@/layouts/UserLayout.astro";
import ReservationWizard from "@/modules/user/reservas/components/ReservationWizard";
---

<UserLayout title="Reserva tu Mesa | DeParraSpitz">
  <main class="max-w-4xl mx-auto space-y-8">
    
    <header class="text-center space-y-3">
      <h1 class="text-4xl md:text-5xl font-black tracking-wider uppercase font-display">
        Haz tu <span class="text-ember">Reserva</span>
      </h1>
      <p class="text-muted-foreground text-sm md:text-base max-w-xl mx-auto">
        Asegura tu lugar en DeParraSpitz y prepárate para una experiencia gastronómica inolvidable.
      </p>
    </header>

    <div class="bg-card border border-border rounded-2xl p-6 md:p-8 shadow-2xl">
      <ReservationWizard client:load />
    </div>

  </main>
</UserLayout>