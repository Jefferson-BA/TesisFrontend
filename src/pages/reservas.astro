---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/globals.css";
import ReservationsAdmin from "@/modules/admin/components/ReservationsAdmin";
import { Toaster } from "sonner";
---

<AdminLayout>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-100">
        Reservas de Eventos
      </h1>
      <p class="text-zinc-400 text-sm">
        Gestiona todas las reservas de catering, buffets y parrilladas.
      </p>
    </div>

    <ReservationsAdmin client:load />
  </div>

  <Toaster richColors position="top-right" client:load />
</AdminLayout>