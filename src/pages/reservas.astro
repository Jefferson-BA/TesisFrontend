---
// src/pages/reservas.astro
import UserLayout from "@/layouts/UserLayout.astro"; 
import ReservationWizard from "@/modules/user/components/ReservationWizard"; 
import "@/styles/globals.css";
import { Toaster } from "sonner";
---

<UserLayout title="Haz tu Reserva | DeParraSpitz">
  <main class="min-h-screen bg-[#0b0806] pt-32 pb-12 px-4">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <header class="text-center">
        <h1 class="text-4xl font-black tracking-wider text-white uppercase">
          Reserva tu <span class="text-yellow-500">Evento</span>
        </h1>
        <p class="text-zinc-400 mt-2">Completa los datos para agendar tu servicio de catering.</p>
      </header>

      <ReservationWizard client:load />

    </div>
  </main>
  
  <Toaster richColors position="top-right" client:load />
</UserLayout>