---
// src/pages/reservas.astro
import UserLayout from "@/layouts/UserLayout.astro";
import ReservationWizard from "@/modules/user/components/ReservationWizard";
import "@/styles/globals.css";
import { Toaster } from "sonner";
---

<UserLayout title="Haz tu Reserva | DeParraSpitz">
  <main class="min-h-screen bg-[#0b0806] pb-24 overflow-x-hidden">

    {/* ══ HERO ══ */}
    <section class="relative pt-40 pb-20 px-4 overflow-hidden"
             style="border-bottom: 1px solid rgba(201,151,74,0.1);">

      {/* Luces de fondo multicapa */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full blur-[160px] pointer-events-none"
           style="background: radial-gradient(ellipse, rgba(201,151,74,0.06) 0%, transparent 65%);"></div>
      <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none"
           style="background: radial-gradient(ellipse, rgba(201,151,74,0.03) 0%, transparent 70%);"></div>
      <div class="absolute top-1/3 right-1/4 w-[250px] h-[250px] rounded-full blur-[100px] pointer-events-none"
           style="background: radial-gradient(ellipse, rgba(201,100,50,0.03) 0%, transparent 70%);"></div>

      {/* Grain overlay */}
      <div class="grain-overlay"></div>

      {/* Arabesco decorativo – esquina superior derecha */}
      <svg class="absolute top-10 right-4 md:right-12 opacity-[0.06] pointer-events-none"
           width="220" height="220" viewBox="0 0 220 220" fill="none">
        <polygon points="110,10 190,60 190,160 110,210 30,160 30,60"
                 stroke="#C9974A" stroke-width="1" fill="none"/>
        <polygon points="110,30 168,68 168,152 110,190 52,152 52,68"
                 stroke="#C9974A" stroke-width="0.6" fill="none"/>
        <polygon points="110,52 148,76 148,144 110,168 72,144 72,76"
                 stroke="#C9974A" stroke-width="0.4" fill="none"/>
        <circle cx="110" cy="110" r="14" stroke="#C9974A" stroke-width="0.5" fill="none"/>
        <circle cx="110" cy="110" r="5"  fill="#C9974A" opacity="0.25"/>
      </svg>

      {/* Arabesco – esquina inferior izquierda, rotado */}
      <svg class="absolute -bottom-8 -left-8 opacity-[0.04] pointer-events-none rotate-180"
           width="180" height="180" viewBox="0 0 180 180" fill="none">
        <polygon points="90,8 156,46 156,134 90,172 24,134 24,46"
                 stroke="#C9974A" stroke-width="1" fill="none"/>
        <circle cx="90" cy="90" r="12" stroke="#C9974A" stroke-width="0.5" fill="none"/>
      </svg>

      <div class="max-w-4xl mx-auto text-center relative z-10 animate-fade-in-up">

        {/* Badge */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6"
             style="background: rgba(201,151,74,0.08); border: 1px solid rgba(201,151,74,0.25);">
          <span style="color: #C9974A; font-size: 10px; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase;">
            ✦ DeParraSpitz Catering ✦
          </span>
        </div>

        {/* Título principal */}
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif tracking-tight text-white leading-[1.1]">
          Reserva tu
          <br>
          <span class="italic font-normal" style="color: #C9974A;">Evento Soñado</span>
        </h1>

        {/* Línea ornamental */}
        <div class="flex items-center justify-center gap-3 mt-6 mb-5">
          <div class="h-px w-16" style="background: linear-gradient(90deg, transparent, rgba(201,151,74,0.5));"></div>
          <span style="color: rgba(201,151,74,0.5); font-size: 10px;">✦</span>
          <div class="h-px w-16" style="background: linear-gradient(270deg, transparent, rgba(201,151,74,0.5));"></div>
        </div>

        <p class="text-zinc-400 text-base sm:text-lg max-w-xl mx-auto font-light leading-relaxed">
          Completa los datos en cuatro pasos sencillos y te enviaremos una
          propuesta de catering a tu medida.
        </p>

        {/* Chips de tipos de evento */}
        <div class="flex flex-wrap justify-center gap-2 mt-8">
          {["💍 Bodas", "💼 Corporativos", "🎂 Fiestas Privadas", "✨ Galas"].map((label) => (
            <span class="px-3 py-1.5 rounded-full text-xs font-medium"
                  style="background: rgba(201,151,74,0.06); border: 1px solid rgba(201,151,74,0.15); color: #9A8060;">
              {label}
            </span>
          ))}
        </div>

        {/* Stats decorativas */}
        <div class="grid grid-cols-3 gap-4 max-w-lg mx-auto mt-10">
          {[
            { num: "+500", label: "Eventos realizados" },
            { num: "15",   label: "Años de experiencia" },
            { num: "★ 4.9", label: "Calificación promedio" },
          ].map((s) => (
            <div class="flex flex-col items-center gap-1 py-4 rounded-xl"
                 style="background: rgba(201,151,74,0.04); border: 1px solid rgba(201,151,74,0.1);">
              <span class="text-xl font-black" style="color: #C9974A;">{s.num}</span>
              <span class="text-[10px] font-light text-center leading-tight" style="color: #5A4A35;">{s.label}</span>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* ══ WIZARD ══ */}
    <div class="max-w-4xl mx-auto px-4 mt-10">
      <ReservationWizard client:load />
    </div>

    {/* ══ FOOTER INFO ══ */}
    <div class="max-w-4xl mx-auto px-4 mt-16 pb-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          { icon: "🔒", title: "Reserva segura",     sub: "Tus datos están protegidos y encriptados." },
          { icon: "📞", title: "Asesoría personal",  sub: "Un coordinador te contactará en 24h."       },
          { icon: "🍽️", title: "Menú personalizado", sub: "Adaptamos cada propuesta a tu evento."      },
        ].map((c) => (
          <div class="flex items-start gap-3 p-4 rounded-2xl"
               style="background: rgba(201,151,74,0.03); border: 1px solid rgba(201,151,74,0.08);">
            <span class="text-2xl shrink-0">{c.icon}</span>
            <div>
              <p class="text-sm font-semibold" style="color: #D4C4A8;">{c.title}</p>
              <p class="text-[11px] mt-0.5 font-light" style="color: #5A4A35;">{c.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </main>

  <Toaster richColors position="top-right" client:load />
</UserLayout>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0);    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .grain-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.4;
  }
</style>