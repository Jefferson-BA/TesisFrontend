---
import '@/styles/globals.css';
import { RegisterForm } from '@/modules/auth/components/RegisterForm';
// 👇 1. Asegúrate de tener esta importación
import { Toaster } from 'sonner'; 
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro | Hojas de Parra Spitz</title>
    <script is:inline>
      (function() {
        try {
          const rawZustand = localStorage.getItem("deparraspitz-theme");
          let theme = "dark";
          if (rawZustand) {
            const parsed = JSON.parse(rawZustand);
            if (parsed?.state?.theme) theme = parsed.state.theme;
          } else {
            const rawSimple = localStorage.getItem("theme");
            if (rawSimple) theme = rawSimple;
          }
          if (theme === "dark") {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <main class="min-h-screen">
      <RegisterForm client:only="react" />
    </main>
    
    <Toaster client:only="react" richColors position="top-right" />
  </body>
</html>