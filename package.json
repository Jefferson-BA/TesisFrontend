{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run check && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests astro.config.mjs vitest.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests astro.config.mjs vitest.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/vercel": "^11.0.18",
    "@fontsource-variable/geist": "^5.2.8",
