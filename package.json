    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.10",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.5",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
